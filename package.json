{
  "name": "studynote",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "devDependencies": { "@playwright/test": "^1.58.0" },
  "scripts": {
    "dev": "node scripts/dev/start.mjs",
    "dev:desktop": "pnpm --filter @studynote/desktop tauri dev",
    "build": "pnpm --filter @studynote/desktop build",
    "typecheck": "pnpm --filter @studynote/desktop typecheck",
    "test": "pnpm --filter @studynote/desktop test",
    "test:e2e": "pnpm --filter @studynote/desktop test:e2e",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1",
    "build:sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build/sidecar.ps1",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build/desktop.ps1"
  }
}
